unit class CSS::Specification::Compiler::Make;

use CSS::Specification::Compiler :&build-metadata;

use NativeCall;

has Array @!made;
has Str   @!root-id;
has Str   $!lib = 'lib';

sub path(RakuAST::Package $p) {
    $p.name.parts>>.name.join: '/';
}

method make-module($where, $namespace, @sources, :%inherit, Str :$lib) {
    $!lib = $_ with $lib;
    my %props;

    indir $where, {
        @!made = ();
        @!root-id = $namespace.split('::');
        my %seen-file;
        my %seen-module;

        note "Building $namespace";

        for @sources {
            my ($submodule-path, $files) = .isa(Pair) ?? .kv !! ([], $_);
            my @submodule-id = flat @!root-id, @$submodule-path, <Gen>;
            my $scope := 'unit';
            my @defs;
            my CSS::Specification::Compiler $compiler .= new;
            note " " ~ $submodule-path.join('::') if .isa(Pair);
            warn "Duplicate sub-module: $submodule-path"
                if %seen-module{$submodule-path}++;

            for $files.List -> $file {
                note " - " ~ $file ~ (%seen-file{$file}++ ?? ' (duplicate)' !! '');
                @defs.append: $compiler.load-defs(:$file);
            }

            mkdir join('/', flat $!lib, @submodule-id);

            my @grammar-id = @submodule-id.Slip, 'Grammar';
            my RakuAST::Package $grammar = $compiler.compile-grammar(@grammar-id, :$scope);

            my @actions-id = @submodule-id.Slip, 'Actions';
            my RakuAST::Package $actions = $compiler.compile-actions(@actions-id, :$scope);

            my @external-id = @submodule-id.Slip, 'External';
            my RakuAST::Package $external = $compiler.compile-external(@external-id, :$scope);

            "$!lib/{.&path}.rakumod".IO.spurt: .DEPARSE
                for $grammar, $actions, $external;

            my %child-rules = $compiler.child-rules;
            my %child-props = $compiler.child-props;
            my %meta = @defs.&build-metadata(:%child-rules, :%child-props);
            %props{.key} //= .value for %meta.pairs;
            @!made.push: @submodule-id;
        }

        %props{.key} //= .value for %inherit.pairs;

        %props.&write-metadata($namespace, :$!lib);
    }
    %props;
}


method link {
    for <Actions Grammar External> -> $link-type {
        my @link-id = flat @!root-id, 'Link', $link-type;
        my RakuAST::Package $package = @!made.&link(@link-id);
        ("$!lib/" ~ $package.&path  ~ ".rakumod").IO.spurt: $package.DEPARSE;
    }
}

sub link(@modules, @base-id) {
    my Str:D $link-type = @base-id.tail;
    my RakuAST::Name $name .= from-identifier-parts(|@base-id);
    my RakuAST::Statement @compiled = @modules.map: -> @module is copy {
        @module.append: $link-type;
        my RakuAST::Name $module-name  .= from-identifier-parts(|@module);
        my RakuAST::Type::Simple $type .= from-identifier-parts(|@module);
        my RakuAST::Trait @traits = $link-type eq 'External'
            ?? RakuAST::Trait::Does.new($type)
            !! RakuAST::Trait::Is.new(:$type);

        slip RakuAST::Statement::Use.new(
              :$module-name
        ), RakuAST::Statement::Also.new(
              :@traits,
        );
    }
    my RakuAST::StatementList $statements .= new: |@compiled;
    my RakuAST::Blockoid $block .= new: $statements;
    my $body-type =  $link-type eq 'External' ?? RakuAST::RoleBody !! RakuAST::Block;
    my $body = $body-type.new: :body($block);

    my RakuAST::Package $package = %(
        :Actions(RakuAST::Class),
        :Grammar(RakuAST::Grammar),
        :External(RakuAST::Role),
    ){$link-type};

    $package.new(
        :$name,
        :$body,
        :scope<unit>,
    );
}

sub write-metadata(%props, $meta, :$lib = 'lib') {
    my $class-dir = $*SPEC.catdir($lib, $meta.split('::').Slip);
    my $class-path = $*SPEC.catfile( $class-dir, 'Metadata.rakumod' );
    my $class-name = "{$meta}::Metadata";
    {
        my $*OUT = open $class-path, :w;
        say "#  -- DO NOT EDIT --";
        say "# generated by: $*PROGRAM-NAME {@*ARGS}".trim;
        say 'use NativeCall;';
        say 'use CSS::Module::Property;';
        say '';
        say "module $class-name \{";
        say '    BEGIN our $property = %(';
        for %props.sort {
            say '         ' ~ .raku.subst(':inherit(Bool::False)', ':!inherit').subst(':inherit(Bool::True)', ':inherit') ~ ',';
        }
        say '       );';
        # todo: BEGIN our \$index = ... ; ## Missing serialize REPR function for REPR
        say '    our enum prop-names <' ~ %props.keys.sort.join(' ') ~ '>;';
        say q:to<END>;
            our sub index {
                state $ //= do {
                    my $enums := prop-names.enums;
                    CArray[CSS::Module::Property].new: |$property.sort.map({CSS::Module::Property.new(:$enums, name => .key, |.value)});
                }
            }
        }
        END
        $*OUT.close;
    }
}
